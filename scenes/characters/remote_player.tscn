[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/player/remote_player.gd" id="1_remote"]
[ext_resource type="SpriteFrames" path="res://resources/characters/knight_frames.tres" id="2_frames"]
[ext_resource type="Texture2D" path="res://assets/characters/ninja/Shadow.png" id="3_shadow"]
[ext_resource type="LabelSettings" path="res://resources/ui/name_label.tres" id="4_name"]
[ext_resource type="Script" path="res://scripts/combat/health_component.gd" id="5_health"]
[ext_resource type="Script" path="res://scripts/combat/hitbox_component.gd" id="6_hitbox"]

[sub_resource type="SceneReplicationConfig" id="SceneReplicationConfig_remote"]
properties/0/path = NodePath(".:display_name")
properties/0/spawn = true
properties/0/replication_mode = 0
properties/1/path = NodePath(".:skin")
properties/1/spawn = true
properties/1/replication_mode = 2
properties/2/path = NodePath(".:net_position")
properties/2/spawn = true
properties/2/replication_mode = 2
properties/3/path = NodePath(".:facing")
properties/3/spawn = true
properties/3/replication_mode = 2
properties/4/path = NodePath(".:max_hp")
properties/4/spawn = true
properties/4/replication_mode = 2
properties/5/path = NodePath(".:hp")
properties/5/spawn = true
properties/5/replication_mode = 2
properties/6/path = NodePath(".:dead")
properties/6/spawn = true
properties/6/replication_mode = 2
properties/7/path = NodePath(".:attack_seq")
properties/7/spawn = true
properties/7/replication_mode = 2
properties/8/path = NodePath(".:level")
properties/8/spawn = true
properties/8/replication_mode = 2

[node name="RemotePlayer" type="Node2D"]
script = ExtResource("1_remote")

[node name="Shadow" type="Sprite2D" parent="."]
modulate = Color(1, 1, 1, 0.6)
position = Vector2(0, -1)
texture = ExtResource("3_shadow")

[node name="Sprite" type="AnimatedSprite2D" parent="."]
position = Vector2(0, -8)
sprite_frames = ExtResource("2_frames")
animation = &"idle_down"

[node name="NameLabel" type="Label" parent="."]
offset_left = -40.0
offset_top = -28.0
offset_right = 40.0
offset_bottom = -18.0
label_settings = ExtResource("4_name")
horizontal_alignment = 1

[node name="Health" type="Node" parent="."]
script = ExtResource("5_health")

[node name="Hitbox" type="Node2D" parent="."]
position = Vector2(0, -6)
script = ExtResource("6_hitbox")

[node name="Sync" type="MultiplayerSynchronizer" parent="."]
delta_interval = 0.05
replication_config = SubResource("SceneReplicationConfig_remote")
